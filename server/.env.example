# AGI Engine 后端配置模板
# 复制为 .env 并填写真实值（.env 不要提交到 git）

# 服务端口
PORT=3000

# PayPal Developer Dashboard -> My Apps & Credentials
# https://developer.paypal.com/dashboard/applications
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=你的_client_id
PAYPAL_SECRET=你的_secret

# PayPal Webhook ID（在 Dashboard -> Webhooks 创建后获得）
# 订阅该事件：PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=你的_webhook_id

# ⚠️ 重要：
# 1. 未配置 PAYPAL_WEBHOOK_ID 时，webhook 接口会记录但拒绝激活订阅（安全设计）。
# 2. 生产环境务必用 PAYPAL_MODE=live 并使用 live 凭据。
# 3. PayPal 付款链接的 custom_id 应设置为客户端 ID，格式如：annual:用户ID 或 monthly:用户ID
#    这样 webhook 才能把付款正确关联到用户。
